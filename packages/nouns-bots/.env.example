NOUNS_SUBGRAPH_URL="https://api.studio.thegraph.com/query/<user-id>/nouns-mainnet/version/latest"
REDIS_URL="redis://<redis-url>"

# OAuth 1.0a user-context credentials for the X account that will publish posts.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""

# Optional worker tuning.
POLL_INTERVAL_MS="30000"
SUBGRAPH_PAGE_SIZE="100"
REDIS_KEY_PREFIX="nouns:proposal-x"
